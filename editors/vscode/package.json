    "viewsContainers": {
      "activitybar": [
        {
          "id": "nxwright",
          "title": "nxwright",
          "icon": "media/nxwright-project-icon.svg"
        },
        {
          "id": "nxwrightPage",
          "title": "nxwright page",
          "icon": "media/nxwright-page-icon.svg"
        }
      ]
    },
    "views": {
      "nxwright": [
        {
          "type": "webview",
          "id": "nxwright.project",
          "name": "Project",
          "initialSize": 1
        },
        {
          "id": "nxwright.media",
          "name": "Media",
          "initialSize": 2
        },
        {
          "type": "webview",
          "id": "nxwright.simulator",
          "name": "Simulator",
          "initialSize": 2
        }
      ],
      "nxwrightPage": [
        {
          "id": "nxwright.pages",
          "name": "Pages"
        },
        {
          "id": "nxwright.components",
          "name": "Components"
        },
        {
          "type": "webview",
          "id": "nxwright.properties",
          "name": "Attributes"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "nxwright.pagePreview",
        "displayName": "nxwright page preview",
        "selector": [
          {
            "filenamePattern": "**/pages/*.page.toml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nxwright.fontViewer",
        "displayName": "nxwright font",
        "selector": [
          {
            "filenamePattern": "*.zi"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nxwright.animationViewer",
        "displayName": "nxwright animation",
        "selector": [
          {
            "filenamePattern": "*.gmov"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nxwright.videoViewer",
        "displayName": "nxwright video",
        "selector": [
          {
            "filenamePattern": "*.video"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "nxwright.soundViewer",
        "displayName": "nxwright sound",
        "selector": [
          {
            "filenamePattern": "**/sounds/*.wav"
          }
        ],
        "priority": "default"
      }
    ],
    "taskDefinitions": [
      {
        "type": "nxwright",
        "required": [
          "subcommand"
        ],
        "properties": {
          "subcommand": {
            "type": "string",
            "description": "The nxwright subcommand the task runs."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "nxwright",
        "owner": "nxwright",
        "source": "nxwright",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:nxwright \\w+: )?(.+?\\.(?:nx|toml)) line (\\d+): (?:(error|warning): )?(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ],
    "breakpoints": [
      {
        "language": "nxwright"
      },
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "nxwright",
        "label": "nxwright test",
        "languages": [
          "nxwright"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "testFolder": {
                "type": "string",
                "description": "To debug a test: the folder of tests, as nxwright test takes it."
              },
              "test": {
                "type": "string",
                "description": "To debug a test: its id, such as test_home.TargetTest.test_raise."
              },
              "sourceFolder": {
                "type": "string",
                "description": "To simulate an app: its source folder."
              },
              "page": {
                "type": "string",
                "description": "Optional: a page to start the simulation on, rather than running program.nx."
              },
              "values": {
                "type": "object",
                "description": "Optional, if starting on a page: the values to start with, by component and attribute.",
                "examples": [{"t0.txt": "Hello", "n0.val": 5}]
              },
              "eeprom": {
                "type": "string",
                "description": "Optional: the file that keeps the EEPROM, as the Nextion Editor keeps its eeprom.bin: the simulation starts from it, and each write the app makes reaches it. Made when missing. Without it, the EEPROM starts empty and lasts for the simulation alone."
              },
              "serialPort": {
                "type": "object",
                "description": "Optional: the serial port the screen's serial line is connected to.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The port's name, such as COM4."
                  },
                  "baud": {
                    "type": "integer",
                    "description": "Its rate, in bits per second. 9600, the screen's rate at power-on, when not given.",
                    "default": 9600
                  }
                },
                "required": [
                  "name"
                ]
              },
              "gpioInputs": {
                "type": "object",
                "description": "Optional: the level each GPIO input starts at, 0 or 1, by pin. Without it, every input reads 1, as a pull-up input that nothing drives does. The Simulator section changes the levels while the app runs.",
                "propertyNames": {
                  "enum": ["pio0", "pio1", "pio2", "pio3", "pio4", "pio5", "pio6", "pio7"]
                },
                "additionalProperties": {
                  "enum": [0, 1]
                },
                "examples": [{"pio2": 0}]
              },
              "sdCard0": {
                "type": "string",
                "description": "Optional: the first virtual SD card (sd0/), a folder by its full path. Without it, the card is kept in memory."
              },
              "sdCard1": {
                "type": "string",
                "description": "Optional: the second virtual SD card (sd1/), a folder by its full path. Without it, the card is kept in memory."
              },
              "pinyinTable": {
                "type": "string",
                "description": "Optional: the screen's pinyin table, for Chinese input: the Nextion Editor's input.bin, or a TFT file, by its full path. Without it, the installed Nextion Editor's, if one is found."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Optional: stop the debugger at the first line that runs (defaults to true for tests, false otherwise)."
              },
              "logReceived": {
                "type": "string",
                "enum": [
                  "text",
                  "hex",
                  "both"
                ],
                "enumDescriptions": [
                  "As text, read in the project's encoding; a byte that is no character shows as \\xNN.",
                  "In hexadecimal, each byte as two digits.",
                  "As text, then in hexadecimal."
                ],
                "default": "text",
                "description": "Optional: serial input debug logging style (overrides nxwright.simulator.logReceived)."
              },
              "logSent": {
                "type": "string",
                "enum": [
                  "text",
                  "hex",
                  "both"
                ],
                "enumDescriptions": [
                  "As text, read in the project's encoding; a byte that is no character shows as \\xNN.",
                  "In hexadecimal, each byte as two digits.",
                  "As text, then in hexadecimal."
                ],
                "default": "hex",
                "description": "Optional: serial output debug logging style (overrides nxwright.simulator.logSent)."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "nxwright: Simulate the app",
            "description": "Runs a source folder's app in the simulator.",
            "body": {
              "type": "nxwright",
              "request": "launch",
              "name": "Simulate the app",
              "sourceFolder": "^\"\\${workspaceFolder}/app\""
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nxwright.debugTest",
          "when": "false"
        },
        {
          "command": "nxwright.showPageText",
          "when": "activeCustomEditorId == nxwright.pagePreview"
        },
        {
          "command": "nxwright.addComponentHere",
          "when": "false"
        },
        {
          "command": "nxwright.deleteComponent",
          "when": "false"
        },
        {
          "command": "nxwright.cutComponent",
          "when": "false"
        },
        {
          "command": "nxwright.copyComponent",
